# The core app runs without these values. Copy this file to .env for online setup.
# Node.js 24 LTS or later.
PORT=3000
BIND_HOST=127.0.0.1
# Set this to your real HTTPS origin for public hosting and live payments.
# PUBLIC_URL=https://gradepath.example.com
# DATA_DIR=./data
# Optional private pilot invite required for new accounts.
# SIGNUP_INVITE_CODE=

# OpenAI API key and model. Keys belong in .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PLUS_LIMIT=60
AI_DAILY_LIMIT=150

# Start with a Paystack TEST key and a monthly NGN 1000 TEST plan.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=
